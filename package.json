{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "format": "eslint . --fix",
    "lint": "eslint .",
    "dev": "concurrently \"NODE_ENV=development nodemon -L\" \"NODE_ENV=development npx ts-node ./src/MessageQueue/index.ts\"",
    "dev:local": "concurrently \" nodemon -L\" \"npx ts-node ./src/MessageQueue/index.ts\"",
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copy-generated.mjs",
    "start": "concurrently \"TS_NODE_BASEURL=./dist node -r tsconfig-paths/register ./dist/src/app.js\" \"TS_NODE_BASEURL=./dist node -r tsconfig-paths/register ./dist/src/MessageQueue/index.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:local": "NODE_ENV=test vitest run",
    "test:e2e": "vitest run --reporter=verbose",
    "test:e2e:watch": "vitest --reporter=verbose",
    "taze:local": "npx taze -r",
    "taze:back": "npx taze major",
    "taze:update": "npx taze major -w",
    "taze:patch": "npx taze patch",
    "compress:ubuntu": "sudo zip -r project.zip .",
    "gen:app": "gen-import --app-config --lazy --map --module-pattern"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-useragent": "^2.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@mohamed-elrefai/tsconfigs": "^1.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/express-useragent": "^1.0.5",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.1.0",
    "@types/uuid": "^11.0.0",
    "bullmq": "^5.79.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "redis": "^6.1.0",
    "resend": "^6.16.0",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  }
}
